{
  "name": "nuxt-newrelic",
  "version": "1.0.1",
  "description": "Nuxt module to integrate New Relic",
  "repository": "attributech/nuxt-newrelic",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@newrelic/native-metrics": "^11.1.0",
    "defu": "^6.1.7",
    "newrelic": "^12.25.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "^1.7.0",
    "@nuxt/eslint-config": "^0.3.13",
    "@nuxt/kit": "^4.4.6",
    "@nuxt/module-builder": "^0.8.4",
    "@nuxt/schema": "^4.4.6",
    "@nuxt/test-utils": "^3.23.0",
    "@types/newrelic": "^9.14.8",
    "@types/node": "^20.19.41",
    "changelogen": "^0.5.7",
    "eslint": "^9.39.4",
    "nuxt": "^4.4.6",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  }
}
